# Runtime data — keep the mount target, ignore its contents.
hermes-data/*
!hermes-data/.gitkeep

# Files exchanged with Hermes through /shared.
hermes-shared/*
!hermes-shared/.gitkeep

# Files exchanged between Hermes and OpenCode through /exchange.
agent-shared/*
!agent-shared/.gitkeep

# Empty default OpenCode workspace for first startup.
opencode-workspace/*
!opencode-workspace/.gitkeep

open-webui
notebooks

# Local secrets. .env.example IS committed; .env and its backups never are.
.env
.env.backup.*

.DS_Store