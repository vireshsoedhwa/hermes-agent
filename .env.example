# =============================================================================
# Hermes Agent — local configuration
#
# To get started:
#
#     cp .env.example .env
#     # Fill in the values below, then:
#     docker compose up -d
#
# `.env` is gitignored and never committed. Only the values below are read by
# docker-compose.yaml; everything else Hermes supports can be configured from
# the dashboard once it is running.
# =============================================================================


# -----------------------------------------------------------------------------
# OpenAI-compatible API server (loopback by default)
# -----------------------------------------------------------------------------
# The API server always runs — the dashboard needs it internally for cron
# fires. By default it binds to 127.0.0.1, so port 8642 is published but not
# reachable from the host. Set HERMES_API_SERVER_HOST=0.0.0.0 to let external
# apps (Open WebUI, LibreChat, any OpenAI SDK) connect on port 8642.
HERMES_API_SERVER_HOST=127.0.0.1

# Always required — the gateway refuses to start the API server without a
# key of at least 16 characters. Generate one with:
#
#     openssl rand -hex 32
#
HERMES_API_SERVER_KEY=


# -----------------------------------------------------------------------------
# Dashboard basic-auth (only engaged on a non-loopback bind)
# -----------------------------------------------------------------------------
# The dashboard auth gate engages only when HERMES_API_SERVER_HOST=0.0.0.0.
# On loopback (the default) no password is required. These env vars override
# the equivalent fields in hermes-data/config.yaml, so rotate the password
# via .env without editing config. Generate a password with:
#     openssl rand -hex 32
#
# For no plaintext at rest, prefer the hash over the password. Compute it
# inside a running container:
#     docker exec -it hermes python -c \
#       "from plugins.dashboard_auth.basic import hash_password; print(hash_password('PW'))"
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
# Session-signing secret. Unset = minted fresh per start (sessions don't
# survive a restart). Set for sticky sessions:  openssl rand -base64 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=


# -----------------------------------------------------------------------------
# Gateway authorization
# -----------------------------------------------------------------------------
# When true, every gateway/dashboard user is authorized with no allowlist.
# Fine for single-user loopback use. Before exposing the dashboard or API
# beyond localhost, set this to false with an explicit user allowlist AND put
# a dashboard auth provider in front of the UI:
# https://hermes-agent.nousresearch.com/docs/user-guide/features/web-dashboard
# Preflight fails startup if this is true while HERMES_API_SERVER_HOST=0.0.0.0.
GATEWAY_ALLOW_ALL_USERS=true


# -----------------------------------------------------------------------------
# REQUIRED — at least one LLM provider
# -----------------------------------------------------------------------------
# Hermes needs a model to run. Set exactly one of the keys below (or several,
# to enable fallbacks), then point HERMES_INFERENCE_PROVIDER at the one you
# want to use by default.

# Ollama Cloud — hosted open models, no GPU needed. https://ollama.com/settings/keys
OLLAMA_API_KEY=

# OpenRouter — one key, 300+ models. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic (Claude). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio (Gemini). https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Groq — very fast inference. https://console.groq.com/keys
GROQ_API_KEY=

# DeepSeek. https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# xAI (Grok). https://console.x.ai
XAI_API_KEY=


# -----------------------------------------------------------------------------
# Model selection
# -----------------------------------------------------------------------------
# Must match a provider whose key you set above. Valid values include:
#   ollama-cloud, openrouter, anthropic, openai, gemini, groq, deepseek, xai
HERMES_INFERENCE_PROVIDER=ollama-cloud

# Model ID for the chosen provider.
#   ollama-cloud → gpt-oss:120b, gemma4:31b, glm-5.2, etc.
#   openrouter   → anthropic/claude-sonnet-4.6, openai/gpt-5.5
#   anthropic    → claude-sonnet-4-6
# A safe default is set below; change it from the dashboard after first boot.
HERMES_DEFAULT_MODEL=gpt-oss:120b


# -----------------------------------------------------------------------------
# Hermes image (pinned by digest for supply-chain safety)
# -----------------------------------------------------------------------------
# Pinned to a multi-arch index digest so a floating :latest tag cannot pull a
# drifted or compromised publish on every `docker compose up`. To upgrade:
#     docker buildx imagetools inspect nousresearch/hermes-agent:latest
# then paste the new "Digest: sha256:..." here. The default below is the digest
# this repo shipped with; override only to upgrade or to pin a specific arch.
HERMES_IMAGE=nousresearch/hermes-agent@sha256:f953da60c908c9e5c35cdbaa355a5851965806d68bd62c616aa03565dd6d2331


# -----------------------------------------------------------------------------
# OPTIONAL — web search
# -----------------------------------------------------------------------------
# Without one of these, the agent cannot search the web. Brave has a free tier.

# Brave Search. https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Tavily — search built for LLMs. https://app.tavily.com/home
TAVILY_API_KEY=

# Exa — semantic search. https://exa.ai
EXA_API_KEY=


# -----------------------------------------------------------------------------
# OPTIONAL — voice and audio transcription
# -----------------------------------------------------------------------------
# ElevenLabs for text-to-speech. https://elevenlabs.io
ELEVENLABS_API_KEY=
# GROQ_API_KEY above also enables Whisper speech-to-text if set.


# -----------------------------------------------------------------------------
# OPTIONAL — chat platforms
# -----------------------------------------------------------------------------
# Set a token to talk to Hermes from that platform. Without any of these you can
# still use the web dashboard, the API server, or `docker exec -it hermes hermes`.

# Telegram — create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=

# Discord. https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Slack. https://api.slack.com/apps
SLACK_BOT_TOKEN=


# -----------------------------------------------------------------------------
# OPTIONAL — storage location
# -----------------------------------------------------------------------------
# Where Hermes keeps everything it owns: config, sessions, memory, skills, and
# logs. This is the one folder to back up, and the one to share between hosts.
# Defaults to ./hermes-data inside this repo. An absolute path works too:
#     HERMES_DATA_DIR=/Users/you/Documents/hermes-data
HERMES_DATA_DIR=./hermes-data

# A local folder mounted into the container at /shared for exchanging files
# with Hermes (e.g. documents, images, exports). Defaults to ./shared.
#     HERMES_SHARED_DIR=/Users/you/Documents/shared
HERMES_SHARED_DIR=./shared


# -----------------------------------------------------------------------------
# OPTIONAL — Linux file ownership
# -----------------------------------------------------------------------------
# On Linux, files the container writes into HERMES_DATA_DIR are owned by UID
# 10000 and may not be editable from your host account. Match the container user
# to yourself by running `id -u` and `id -g` and pasting the results here.
# macOS and Windows users can ignore this — Docker Desktop handles it.
# HERMES_UID=1000
# HERMES_GID=1000
