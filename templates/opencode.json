{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "external_directory": {
      "*": "deny",
      "/exchange/**": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "edit": {
      "*": "allow",
      ".git/**": "deny",
      ".github/workflows/**": "ask"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "rm -rf *": "deny",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm run check*": "allow",
      "npm run build*": "allow",
      "npx jest*": "allow",
      "npx vitest*": "allow",
      "npx tsc*": "allow",
      "npx eslint*": "allow",
      "yarn test*": "allow",
      "yarn lint*": "allow",
      "yarn typecheck*": "allow",
      "pnpm test*": "allow",
      "pnpm lint*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm build*": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow",
      "python -m unittest*": "allow",
      "ruff*": "allow",
      "mypy*": "allow",
      "flake8*": "allow",
      "black --check*": "allow",
      "isort --check*": "allow",
      "go test*": "allow",
      "go vet*": "allow",
      "go build*": "allow",
      "gofmt -l*": "allow",
      "cargo test*": "allow",
      "cargo clippy*": "allow",
      "cargo fmt --check*": "allow",
      "cargo build*": "allow",
      "make test*": "allow",
      "make check*": "allow",
      "make lint*": "allow",
      "make build*": "allow",
      "mvn test*": "allow",
      "gradle test*": "allow",
      "dotnet test*": "allow",
      "dotnet build*": "allow",
      "rake test*": "allow",
      "mix test*": "allow"
    }
  }
}
